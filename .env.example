# SerpApi Google Flights API key (optional; 250 free searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Optional delay (in seconds) between uncached live flight requests to respect rate limits
# Defaults to 1.0s for fast-flights and 0.4s for SerpApi when unset
# FLIGHT_SEARCH_DELAY_SECONDS=1.0

# Optional SQLite flight cache TTL in days (defaults to 7 days)
# FLIGHT_CACHE_TTL_DAYS=7

